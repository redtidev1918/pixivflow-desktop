{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PixivFlow Desktop",
  "version": "0.2.0",
  "identifier": "dev.redtidev.pixivflowdesktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "PixivFlow Desktop",
        "width": 1100,
        "height": 780,
        "minWidth": 720,
        "minHeight": 520,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": []
  }
}
