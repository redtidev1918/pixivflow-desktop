{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PixivFlow Desktop",
  "version": "0.2.0",
  "identifier": "dev.redtidev.pixivflowdesktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "PixivFlow Desktop",
        "width": 1100,
        "height": 780,
        "minWidth": 720,
        "minHeight": 520,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/mock-backend.mjs": "mock-backend.mjs",
      "resources/runtime/pixivflow/runtime-manifest.json": "runtime/pixivflow/runtime-manifest.json",
      "resources/runtime/pixivflow/VERSION": "runtime/pixivflow/VERSION",
      "resources/runtime/pixivflow/dev-backend.mjs": "runtime/pixivflow/dev-backend.mjs",
      "resources/webui/dist/index.html": "webui/dist/index.html"
    }
  }
}
