{
  "name": "pixivflow-desktop",
  "productName": "PixivFlow Desktop",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "PixivFlow Desktop — native desktop shell, local backend lifecycle management and runtime status monitoring.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "postbuild": "node scripts/check-dist.mjs && node scripts/check-runtime.mjs",
    "test": "node --test src/frontend/*.test.mjs && node scripts/check-version-sync.mjs && node scripts/check-dist.mjs",
    "test:frontend": "node --test src/frontend/*.test.mjs",
    "test:version": "node scripts/check-version-sync.mjs",
    "release:set-version": "node scripts/set-release-version.mjs",
    "test:dist": "node scripts/check-dist.mjs",
    "tauri": "tauri",
    "test:runtime": "node scripts/check-runtime.mjs",
    "runtime:fetch": "node scripts/fetch-pixivflow-runtime.mjs",
    "webui:fetch": "node scripts/fetch-pixivflow-webui.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "vite": "^6"
  }
}
