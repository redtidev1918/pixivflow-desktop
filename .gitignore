# Dependencies / build artifacts
node_modules/
src-tauri/target/
src-tauri/gen/
# allow-*/deny-* permission TOMLs generated by tauri-build from the app manifest
# in src-tauri/build.rs (that command list is the source of truth).
src-tauri/permissions/autogenerated/

# Bundled upstream outputs (filled from Phase 2)
src-tauri/resources/backend/dist/
src-tauri/resources/backend/node_modules/
src-tauri/resources/webui/*
# keep placeholder .gitkeep dirs for a fresh checkout
!**/.gitkeep

# Bundled REAL runtime, laid out by scripts/fetch-pixivflow-runtime.mjs (F2.3).
# Fetch acquires dist/ + prod-only node_modules/ + package.json into
# src-tauri/resources/runtime/pixivflow/ and rewrites runtime-manifest.json in
# place as a LOCAL working artifact. The committed manifest stays the dev
# stand-in (dev-backend.mjs) so a fresh clone runs light until fetch runs.
src-tauri/resources/runtime/pixivflow/dist/
src-tauri/resources/runtime/pixivflow/node_modules/
src-tauri/resources/runtime/pixivflow/node
src-tauri/resources/runtime/pixivflow/node.exe
src-tauri/resources/runtime/pixivflow/package.json
src-tauri/resources/runtime/pixivflow/package-lock.json


# Logs
*.log

# OS / editor
.DS_Store
Thumbs.db
.idea/

.vscode/

dist/
# Version the bundled WebUI placeholder contract (方案 A); the real dist from
# pixivflow-webui overwrites src-tauri/resources/webui/dist/ at build time
# (F4.1): assets/ stay a local artifact, index.html is tracked as placeholder.
!src-tauri/resources/webui/
!src-tauri/resources/webui/dist/
!src-tauri/resources/webui/dist/index.html
# the real WebUI bundle (assets/) is a build product — only the placeholder above
src-tauri/resources/webui/dist/assets/

# Runtime data written next to the app when the bundled backend is started from
# a checkout (the installed app uses the per-user app data directory instead).
/config/
